#!/usr/bin/env bash
# Clone a repo into the ~/src/{work,personal,sandbox} layout and print where it
# landed. The `rc` wrapper in home.nix cds to that path.
#
# work keeps the namespace (~/src/work/acme/api) because one owner there has
# many repos; personal and sandbox flatten to a bare name.

set -euo pipefail

PROGRAM_NAME="$(basename "$0")"
REPO_ROOT="${REPO_ROOT:-$HOME/src}"
DRY_RUN=0

log() { printf '[%s] %s\n' "${PROGRAM_NAME}" "$*" >&2; }
fail() {
  printf '[%s] error: %s\n' "${PROGRAM_NAME}" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  repo-clone [--dry-run] <work|personal|sandbox> <repo>

Repo may be OWNER/REPO (GitHub), HOST/OWNER/REPO, or any git URL
(https://, ssh://, git@host:owner/repo.git).

Examples:
  repo-clone work acme/api                -> ~/src/work/acme/api
  repo-clone personal dillionverma/dotfiles -> ~/src/personal/dotfiles
  repo-clone sandbox https://github.com/someone/test -> ~/src/sandbox/test
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*) fail "unknown option: $1 (see --help)" ;;
    *) break ;;
  esac
  shift
done

[[ $# -eq 2 ]] || {
  usage >&2
  exit 1
}
BUCKET="$1"
SPEC="${2%/}"

case "${BUCKET}" in
  work | personal | sandbox) ;;
  *) fail "unknown bucket: ${BUCKET}. Expected work, personal, or sandbox" ;;
esac

# Resolve SPEC to a clone URL and an owner/name pair. GH_SHORTHAND marks the
# plain OWNER/REPO form, the only one `gh repo clone` can take directly.
GH_SHORTHAND=0
if [[ "${SPEC}" =~ ^[[:alnum:]_.-]+/[[:alnum:]_.-]+$ ]]; then
  REPO_PATH="${SPEC}"
  CLONE_URL="https://github.com/${SPEC}.git"
  GH_SHORTHAND=1
elif [[ "${SPEC}" =~ ^[[:alpha:]][[:alnum:]+.-]*:// ]]; then # https://, ssh://, ...
  rest="${SPEC#*://}"
  REPO_PATH="${rest#*/}"
  CLONE_URL="${SPEC}"
elif [[ "${SPEC}" =~ ^([^@]+@)?[^:/]+:/?(.+)$ ]]; then # git@host:owner/repo.git
  REPO_PATH="${BASH_REMATCH[2]}"
  CLONE_URL="${SPEC}"
elif [[ "${SPEC}" =~ ^[[:alnum:].-]+\.[[:alnum:]-]+/.+/.+$ ]]; then # host/owner/repo
  REPO_PATH="${SPEC#*/}"
  CLONE_URL="https://${SPEC}.git"
else
  fail "unsupported repo spec: ${SPEC} (see --help)"
fi

REPO_PATH="${REPO_PATH#/}"
REPO_PATH="${REPO_PATH%.git}"
[[ "${REPO_PATH}" == */* ]] || fail "expected a namespace and repo name in: ${SPEC}"

NAMESPACE="${REPO_PATH%/*}"
NAME="${REPO_PATH##*/}"
[[ -n "${NAMESPACE}" && -n "${NAME}" ]] || fail "could not determine destination from: ${SPEC}"

if [[ "${BUCKET}" == work ]]; then
  DESTINATION="${REPO_ROOT%/}/${BUCKET}/${NAMESPACE}/${NAME}"
else
  DESTINATION="${REPO_ROOT%/}/${BUCKET}/${NAME}"
fi

# Already cloned: report the path and succeed, so `rc` still cds there.
if [[ -d "${DESTINATION}/.git" ]]; then
  log "already exists at ${DESTINATION}"
  printf '%s\n' "${DESTINATION}"
  exit 0
fi
[[ ! -e "${DESTINATION}" ]] || fail "destination already exists: ${DESTINATION}"

command -v git >/dev/null 2>&1 || fail "missing required command: git"
if [[ "${GH_SHORTHAND}" -eq 1 ]] && command -v gh >/dev/null 2>&1; then
  METHOD=gh
else
  METHOD=git
fi

log "${BUCKET}: ${SPEC} -> ${DESTINATION} (via ${METHOD})"
if [[ "${DRY_RUN}" -eq 1 ]]; then
  printf '%s\n' "${DESTINATION}"
  exit 0
fi

mkdir -p "$(dirname "${DESTINATION}")"
if [[ "${METHOD}" == gh ]]; then
  gh repo clone "${REPO_PATH}" "${DESTINATION}" >&2
else
  git clone -- "${CLONE_URL}" "${DESTINATION}" >&2
fi

printf '%s\n' "${DESTINATION}"
