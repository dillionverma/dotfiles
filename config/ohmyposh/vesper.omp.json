{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "#ff8080",
          "template": "# "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#ffffff",
          "template": "<b>{{ .Path }}</b>",
          "options": {
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#99ffe4",
          "template": " {{ .HEAD }}{{ if gt .Behind 0 }} <#ffc799>⇣{{ .Behind }}</>{{ end }}{{ if gt .Ahead 0 }} <#ffc799>⇡{{ .Ahead }}</>{{ end }}{{ if .Working.Changed }} <#7d7d7d>±{{ .Working.Changed }}</>{{ end }}",
          "options": {
            "fetch_status": true,
            "branch_icon": "",
            "commit_icon": "@"
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#ff8080",
          "template": " ✕ {{ .Code }}",
          "options": {
            "always_enabled": false
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#99ffe4",
          "template": " ›"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "python",
          "style": "plain",
          "foreground": "#ffc799",
          "template": "py {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}"
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#b8a1ff",
          "template": " node {{ .Full }}",
          "options": {
            "fetch_version": true
          }
        }
      ]
    }
  ]
}
