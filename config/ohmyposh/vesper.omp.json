{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "#ff8080",
          "template": "# "
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "▐",
          "trailing_diamond": "▌",
          "background": "#1f1f1f",
          "foreground": "#ffffff",
          "template": "{{ .Path }}",
          "options": {
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": " ▐",
          "trailing_diamond": "▌",
          "background": "#99ffe4",
          "foreground": "#101010",
          "template": "{{ .HEAD }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }}{{ if gt .Ahead 0 }} ⇡{{ .Ahead }}{{ end }}{{ if .Working.Changed }} ±{{ .Working.Changed }}{{ end }}",
          "options": {
            "fetch_status": true,
            "branch_icon": "",
            "commit_icon": "@"
          }
        },
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": " ▐",
          "trailing_diamond": "▌",
          "background": "#f5a97f",
          "foreground": "#101010",
          "template": "{{ if gt .Code 0 }}✕ {{ .Code }}{{ else }}✓{{ end }}",
          "options": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "▐",
          "trailing_diamond": "▌",
          "background": "#ffc799",
          "foreground": "#101010",
          "template": "py {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}"
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": " ▐",
          "trailing_diamond": "▌",
          "background": "#b8a1ff",
          "foreground": "#101010",
          "template": "node {{ .Full }}",
          "options": {
            "fetch_version": true
          }
        }
      ]
    }
  ]
}
