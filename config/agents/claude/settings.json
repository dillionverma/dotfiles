{
  "agentPushNotifEnabled": true,
  "autoUpdatesChannel": "latest",
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "paper-desktop@paper": true,
    "posthog@claude-plugins-official": true,
    "pstack@pstack-claude": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "extraKnownMarketplaces": {
    "paper": {
      "source": {
        "repo": "paper-design/agent-plugins",
        "source": "github"
      }
    },
    "pstack-claude": {
      "source": {
        "repo": "michael-denyer/pstack-claude",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "mcp__.*linear.*(issue_create|issue_update|save_issue)",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/linear-method.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bb connect expose:*)"
    ],
    "ask": [
      "mcp__msgvault__export_attachment"
    ],
    "deny": [
      "mcp__msgvault__stage_deletion"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen"
}
