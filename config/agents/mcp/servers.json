{
  "servers": {
    "beeper": {
      "url": "http://127.0.0.1:23373/v0/mcp"
    },
    "icon-composer": {
      "command": "/etc/profiles/per-user/dillion/bin/node",
      "args": [
        "/Users/dillion/.local/share/icon-composer-mcp/node_modules/icon-composer-mcp/dist/server.js"
      ]
    },
    "msgvault": {
      "command": "/Users/dillion/.local/bin/msgvault",
      "args": [
        "mcp"
      ],
      "disabledTools": [
        "stage_deletion"
      ],
      "codex": {
        "tools": {
          "export_attachment": {
            "approval_mode": "prompt"
          },
          "aggregate": {
            "approval_mode": "approve"
          },
          "get_attachment": {
            "approval_mode": "approve"
          },
          "get_message": {
            "approval_mode": "approve"
          },
          "get_stats": {
            "approval_mode": "approve"
          },
          "list_messages": {
            "approval_mode": "approve"
          },
          "search_by_domains": {
            "approval_mode": "approve"
          },
          "search_in_message": {
            "approval_mode": "approve"
          },
          "search_message_bodies": {
            "approval_mode": "approve"
          },
          "search_messages": {
            "approval_mode": "approve"
          },
          "search_metadata": {
            "approval_mode": "approve"
          },
          "semantic_search_messages": {
            "approval_mode": "approve"
          }
        }
      }
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ],
      "codex": {
        "tools": {
          "browser_eval": {
            "approval_mode": "approve"
          },
          "init": {
            "approval_mode": "approve"
          },
          "nextjs_call": {
            "approval_mode": "approve"
          },
          "nextjs_index": {
            "approval_mode": "approve"
          }
        }
      }
    },
    "notion": {
      "command": "/etc/profiles/per-user/dillion/bin/node",
      "args": [
        "/Users/dillion/.bb/thread-storage/notion-api/launch.mjs"
      ]
    },
    "openseo": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.15.2",
        "https://app.openseo.so/mcp",
        "33412",
        "--auth-timeout",
        "120"
      ]
    },
    "paper": {
      "command": "/Users/dillion/.paper/bin/paper",
      "args": [
        "mcp"
      ]
    },
    "personal": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.15.2",
        "https://mcp.dillion.io/mcp",
        "33410",
        "--auth-timeout",
        "120"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--config",
        "/Users/dillion/.playwright-mcp/config.json",
        "--user-data-dir",
        "/Users/dillion/.playwright-mcp/profiles/{harness}",
        "--output-dir",
        "/Users/dillion/Downloads/playwright-mcp"
      ]
    },
    "product-studio": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.15.2",
        "https://mcp.product.studio/mcp?codemode=search_and_execute",
        "33411",
        "--auth-timeout",
        "120"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    }
  },
  "unmanaged": {
    "codex": [
      "computer-use",
      "node_repl"
    ]
  }
}
